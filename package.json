{
  "name": "@xrendan/ai-starter",
  "version": "0.1.0",
  "description": "AI-driven repository setup and management tool",
  "type": "module",
  "bin": {
    "ai": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "build:binary": "bun build ./src/index.ts --compile --outfile ai",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "clean": "rm -rf dist ai node_modules"
  },
  "keywords": [
    "cli",
    "ai",
    "repository",
    "setup",
    "git-ai",
    "perfect-commits",
    "mkdocs",
    "tui",
    "opentui"
  ],
  "author": "xrendan",
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.1.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitepress": "^1.5.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
