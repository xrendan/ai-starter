{
  "name": "@xrendan/ai-starter",
  "version": "0.1.0",
  "description": "AI-driven repository setup and management tool",
  "type": "module",
  "bin": {
    "ai": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "build:binary": "bun build ./src/index.ts --compile --outfile ai",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist ai node_modules"
  },
  "keywords": [
    "cli",
    "ai",
    "repository",
    "setup",
    "git-ai",
    "perfect-commits",
    "mkdocs",
    "tui",
    "opentui"
  ],
  "author": "xrendan",
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.1.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
